{
  "name": "sigserver-viewer",
  "version": "1.0.0",
  "description": "Visor Geoespacial Web de Redes Electricas basado en ArcGIS Server (sin AGOL/Portal)",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "server": "node server/authServer.mjs"
  },
  "dependencies": {
    "@arcgis/core": "^4.31.6",
    "@arcgis/map-components": "^4.31.6",
    "@arcgis/map-components-react": "^4.31.6",
    "@esri/calcite-components": "^3.0.0",
    "@esri/calcite-components-react": "^3.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-static-copy": "^2.1.0",
    "vitest": "^2.1.9"
  }
}
