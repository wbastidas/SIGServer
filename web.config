<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuracion de IIS para el Visor de Redes Electricas (SPA React + Vite).
  Cumple: RNF-IIS-01 (URL Rewrite fallback SPA), RNF-IIS-02 (MIME .wasm/.json/ESM),
  RNF-IIS-03 (proxy/ARR opcional), RNF-IIS-04 (compresion + cache), RNF-SEC-04 (cabeceras).

  Requiere en el servidor: modulo "URL Rewrite" y, si se usa proxy al backend/ArcGIS,
  "Application Request Routing (ARR)" con proxy habilitado.
-->
<configuration>
  <system.webServer>

    <!-- MIME types requeridos por modulos ES, WebAssembly y configuracion JSON -->
    <staticContent>
      <remove fileExtension=".wasm" />
      <mimeMap fileExtension=".wasm" mimeType="application/wasm" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".mjs" />
      <mimeMap fileExtension=".mjs" mimeType="text/javascript" />
      <remove fileExtension=".js" />
      <mimeMap fileExtension=".js" mimeType="text/javascript" />
      <remove fileExtension=".pbf" />
      <mimeMap fileExtension=".pbf" mimeType="application/x-protobuf" />
    </staticContent>

    <httpProtocol>
      <customHeaders>
        <!-- RNF-SEC-04: cabeceras de seguridad. Ajuste CSP segun sus dominios.
             Nota: frame-src / connect-src incluyen Google para Street View (RF-GSV). -->
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
      </customHeaders>
    </httpProtocol>

    <!-- RNF-IIS-04: compresion -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <rewrite>
      <rules>
        <!--
          RNF-IIS-03 (opcional): proxy hacia el backend de autenticacion/token broker.
          Descomente y ajuste si publica el backend detras del mismo origen (evita CORS).
        -->
        <!--
        <rule name="ProxyAuthApi" stopProcessing="true">
          <match url="^sig-api/(.*)" />
          <action type="Rewrite" url="http://localhost:4000/{R:1}" />
        </rule>
        -->

        <!-- RNF-IIS-01: fallback SPA. Cualquier ruta que no sea archivo/carpeta
             real ni empiece por sig-api se sirve con index.html -->
        <rule name="SPA-Fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/sig-api/" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <!-- RNF-IIS-04: cache de estaticos. La config JSON se sirve SIN cache para
         permitir recarga sin recompilar (RNF-CFG-03). -->
    <caching>
      <profiles>
        <add extension=".json" policy="DontCache" kernelCachePolicy="DontCache" />
      </profiles>
    </caching>

  </system.webServer>
</configuration>
