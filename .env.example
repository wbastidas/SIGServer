# ===========================================================================
#  Variables de entorno del Visor de Redes Electricas
#  Copie este archivo a `.env` y ajuste los valores. NUNCA suba `.env` al repo.
# ===========================================================================

# --- Frontend (expuestas al navegador, prefijo obligatorio VITE_) ----------

# Clave de Google Maps JavaScript API para Google Street View (RF-GSV).
# Dependencia externa opcional; si se omite, Street View se degrada con elegancia.
VITE_GOOGLE_MAPS_KEY=

# URL base del backend de autenticacion / proxy. Vacio = modo demo en cliente.
# Ej: https://miservidor/sig-api
VITE_AUTH_API_URL=

# --- Backend (server/authServer.mjs) - NUNCA expuestas al cliente ----------

# Secreto para firmar los JWT. Genere uno robusto en produccion.
JWT_SECRET=cambie-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_MINUTES=60
AUTH_PORT=4000

# Credenciales del ArcGIS Server (solo si los servicios estan securizados con token).
# El token se genera del lado servidor y NUNCA llega al navegador (RNF-SEC-03).
ARCGIS_TOKEN_URL=https://geoportal.cnelep.gob.ec/arcgis/tokens/generateToken
ARCGIS_USERNAME=
ARCGIS_PASSWORD=
